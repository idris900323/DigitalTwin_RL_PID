# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# PyBullet
*.bullet
*.urdf.bak

# RL / experiment outputs (Stable-Baselines3, TensorBoard, W&B, etc.)
# Note: results/ itself IS committed (small demo plots, team wants them
# visible without regenerating) -- only future large/heavy RL run dirs are
# ignored here.
runs/
wandb/
logs/
*.zip
tensorboard_logs/

# Note: cad/JGB37-520_converted.glb IS committed on purpose -- it's a small
# (~500KB) required input for simulation/cad_pid_visualizer.py, not a build
# cache. Regenerate it with cad/convert_step_to_glb.py if the source STEP
# changes. Any *other* ad-hoc CAD exports stay untracked:
cad/*.stl
cad/*.obj

# Test / tooling caches and large temporary renders
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
results/tmp/
# large per-tick raw logs are regenerated by the scripts (python simulation/simulate_pid.py)
*_raw.csv
*.tmp

# Local reference copies of the original files (the oracle reads them from git history instead)
html/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.iml
# .vscode/ intentionally NOT ignored -- shared editor settings live there.
# If a teammate wants personal overrides, use .vscode/*.local.json patterns
# instead of committing machine-specific settings.

# Env / secrets
.env
*.local
